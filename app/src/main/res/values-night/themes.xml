<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GlassOrb.Base" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/app_surface_dark</item>
        <item name="android:colorBackground">@color/app_surface_dark</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#99EBEBF5</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:colorAccent">@color/brand_blue_dark</item>
