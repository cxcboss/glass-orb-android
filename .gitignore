# Machine-local configuration and tool state
/local.properties
/.idea/
*.iml
.DS_Store
/.omx/
/.superpowers/
/.claude/
/.cursor/
/.codex/

# Build outputs and caches (the Gradle build dir is redirected to the system temp dir)
/.gradle/
/.kotlin/
**/build/
/.externalNativeBuild/
/.cxx/

# Debris from local runs
*.apk.zip
*.hprof
*.log
/captures/

# APKs are published as GitHub Release assets, never committed. dist/ keeps only
# the release notes and checksum; a locally built APK placed there stays ignored.
/dist/*.apk
